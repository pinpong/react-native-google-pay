{
  "name": "react-native-google-pay",
  "version": "2.1.0",
  "description": "React Native bridge for Google Pay",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "prettier:fix": "prettier --write '**/*.{js,ts,tsx}'",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "demo": "yarn workspace react-native-google-pay-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build && node scripts/add-googlepay-reference.js",
    "build": "bob build && node scripts/add-googlepay-reference.js"
  },
  "keywords": [
    "react-native",
    "google-pay",
    "android-pay",
    "payments",
    "pay"
  ],
  "author": "Andrey Sorokin <sorokin0andrey@gmail.com> (https://github.com/sorokin0andrey)",
  "license": "MIT",
  "nativePackage": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/busfor/react-native-google-pay.git"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.36.0",
    "@react-native-community/cli": "^20.0.2",
    "@react-native/babel-preset": "^0.81.4",
    "@react-native/eslint-config": "^0.81.4",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.13",
    "auto-changelog": "^2.5.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-native": "^0.81.4",
    "react-native-builder-bob": "^0.40.13",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@types/googlepay": "0.7.7"
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs"
      ],
      [
        "module"
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNGooglePaySpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.busfor"
    }
  },
  "create-react-native-library": {
    "languages": "kotlin-objc",
    "type": "turbo-module",
    "version": "0.54.3"
  },
  "packageManager": "yarn@3.6.1"
}
